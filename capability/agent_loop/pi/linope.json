  "name": "agent_loop_pi",
  "command": ["node", "capability/agent_loop/pi/main.mjs"],
  "resources": [
    {
      "kind": "memory",
      "identity": {"scope": "chat"},
      "call_params": {}
    }
  ],
  "settings": {
    "model": "model.openai_chat_model",
